# Safe local-development placeholders only. Never commit .env.
FAMILYCARE_ENV=development
# Phase 1 routes require both FAMILYCARE_ENV=development and this exact true opt-in.
FAMILYCARE_ENABLE_SYNTHETIC_INGESTION=false
FAMILYCARE_DATABASE_HOST=127.0.0.1
FAMILYCARE_DATABASE_PORT=5432
FAMILYCARE_DATABASE_NAME=familycare
FAMILYCARE_DATABASE_USER=familycare
FAMILYCARE_DATABASE_PASSWORD=replace-for-local-development
FAMILYCARE_DATABASE_URL=postgresql+psycopg://familycare:replace-for-local-development@127.0.0.1:5432/familycare
FAMILYCARE_API_PORT=8000
FAMILYCARE_WEB_PORT=8080
FAMILYCARE_TMPDIR=/tmp
FAMILYCARE_DOCUMENT_ROOT=/absolute/path/outside/repository
FAMILYCARE_WORK_ROOT=/absolute/path/outside/repository/work
FAMILYCARE_IMPORT_ROOT=/absolute/path/outside/repository/import
FAMILYCARE_ARCHIVE_MASTER_KEY_FILE=/absolute/path/outside/repository/familycare_archive_master_key
# Synthetic interpolation placeholder only. Never place an actual API key in this file.
OPENAI_API_KEY=replace-for-local-development
FAMILYCARE_AI_STRUCTURER_MODEL=gpt-5.6-luna
FAMILYCARE_AI_VERIFIER_MODEL=gpt-5.6-terra
