  "$id": "https://familycare.local/contracts/coverage-decision.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict combined operational and private-knowledge decision output with bounded assistance.",
  "properties": {
    "analysis_completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNAVAILABLE"
      ],
      "title": "Analysis Completeness",
      "type": "string"
    },
    "assistance": {
      "$ref": "#/$defs/AnalysisAssistanceResponse"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/ClaimCandidateResponse"
      },
      "maxItems": 10000,
      "title": "Candidates",
      "type": "array"
    },
    "catalog_coverage": {
      "$ref": "#/$defs/CatalogCoverageResponse"
    },
    "conditional_fixed_subtotals": {
      "items": {
        "$ref": "#/$defs/ConditionalFixedSubtotalResponse"
      },
      "maxItems": 32,
      "title": "Conditional Fixed Subtotals",
      "type": "array"
    },
    "engine_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Engine Version",
      "type": "string"
    },
    "evaluations": {
      "items": {
        "$ref": "#/$defs/RuleEvaluationResponse"
      },
      "maxItems": 512,
      "title": "Evaluations",
      "type": "array"
    },
    "event_version": {
      "minimum": 1,
      "title": "Event Version",
      "type": "integer"
    },
    "indemnity_summary": {
      "$ref": "#/$defs/IndemnitySummaryResponse"
    },
    "knowledge_snapshot_version": {
      "$ref": "#/$defs/KnowledgeSnapshotVersionResponse"
    },
    "medical_event_id": {
      "format": "uuid",
      "title": "Medical Event Id",
      "type": "string"
    },
    "policy_snapshot_at": {
      "format": "date-time",
      "title": "Policy Snapshot At",
      "type": "string"
    },
    "rule_set_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Rule Set Version",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_failure_codes": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Source Failure Codes",
      "type": "array"
    },
    "stale": {
      "title": "Stale",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "medical_event_id",
    "event_version",
    "engine_version",
    "rule_set_version",
    "knowledge_snapshot_version",
    "policy_snapshot_at",
    "stale",
    "analysis_completeness",
    "catalog_coverage",
    "candidates",
    "evaluations",
    "conditional_fixed_subtotals",
    "indemnity_summary",
    "source_failure_codes",
    "assistance"
  ],
  "title": "CoverageDecision",
  "type": "object"
}
