{
  "$id": "https://familycare.invalid/schemas/document-batch.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict request for one FamilyMember-scoped encrypted document batch.",
  "properties": {
    "family_member_id": {
      "$ref": "#/$defs/FamilyMemberId"
    },
    "schema_version": {
      "const": "1",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/DocumentBatchSource"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "family_member_id",
    "sources"
  ],
  "title": "DocumentBatchRequest",
  "type": "object",
  "$defs": {
    "FamilyMemberId": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "FamilyMemberId",
      "type": "string"
    },
    "BatchDocumentKind": {
      "enum": [
        "application",
        "policy",
        "product_explanation",
        "supporting",
        "terms"
      ],
      "title": "BatchDocumentKind",
      "type": "string"
    },
    "DocumentBatchSource": {
      "additionalProperties": false,
      "properties": {
        "document_kind": {
          "$ref": "#/$defs/BatchDocumentKind"
        },
        "source_id": {
          "$ref": "#/$defs/SourceId"
        }
      },
      "required": [
        "source_id",
        "document_kind"
      ],
      "title": "DocumentBatchSource",
      "type": "object"
    },
    "SourceId": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "title": "SourceId",
      "type": "string"
    }
  }
}
