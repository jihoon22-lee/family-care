{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://familycare.local/contracts/claim-workflow.v1.schema.json",
  "title": "ClaimWorkflowEnvelope",
  "description": "Strict transport-neutral ClaimCase, checklist, transition, snapshot, and history data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_case",
    "snapshot",
    "checklist",
    "status_events",
    "history"
  ],
  "properties": {
    "schema_version": {
      "const": "1",
      "type": "string"
    },
    "claim_case": {
      "$ref": "#/$defs/ClaimCase"
    },
    "snapshot": {
      "$ref": "#/$defs/ClaimCaseSnapshot"
    },
    "checklist": {
      "items": {
        "$ref": "#/$defs/ChecklistItem"
      },
      "maxItems": 64,
      "type": "array"
    },
    "status_events": {
      "items": {
        "$ref": "#/$defs/ClaimStatusEvent"
      },
      "maxItems": 64,
      "type": "array"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/ClaimHistory"
      },
      "maxItems": 64,
      "type": "array"
    }
  },
  "$defs": {
    "Uuid": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Uuid",
      "type": "string"
    },
    "UuidOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "type": "null"
        }
      ],
      "title": "UuidOrNull"
    },
    "PositiveVersion": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "PositiveVersion",
      "type": "integer"
    },
    "PositiveVersionOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/PositiveVersion"
        },
        {
          "type": "null"
        }
      ],
      "title": "PositiveVersionOrNull"
    },
    "DateTime": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "DateTime",
      "type": "string"
    },
    "DateOrNull": {
      "anyOf": [
        {
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "DateOrNull"
    },
    "VersionString": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "VersionString",
      "type": "string"
    },
    "Code": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "title": "Code",
      "type": "string"
    },
    "ReasonCode": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
      "title": "ReasonCode",
      "type": "string"
    },
    "ReasonCodeOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReasonCode"
        },
        {
          "type": "null"
        }
      ],
      "title": "ReasonCodeOrNull"
    },
    "CurrencyCode": {
      "maxLength": 3,
      "minLength": 3,
      "pattern": "^[A-Z]{3}$",
      "title": "CurrencyCode",
      "type": "string"
    },
    "CurrencyCodeOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/CurrencyCode"
        },
        {
          "type": "null"
        }
      ],
      "title": "CurrencyCodeOrNull"
    },
    "DecimalString": {
      "maxLength": 19,
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,2})?$",
      "title": "DecimalString",
      "type": "string"
    },
    "DecimalStringOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecimalString"
        },
        {
          "type": "null"
        }
      ],
      "title": "DecimalStringOrNull"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/DecimalString"
        },
        "currency": {
          "$ref": "#/$defs/CurrencyCode"
        }
      },
      "required": ["amount", "currency"],
      "title": "Money",
      "type": "object"
    },
    "MoneyOrNull": {
      "anyOf": [
        {
          "$ref": "#/$defs/Money"
        },
        {
          "type": "null"
        }
      ],
      "title": "MoneyOrNull"
    },
    "ClaimStatus": {
      "enum": [
        "preparing",
        "submitted",
        "supplementation_requested",
        "paid",
        "partially_paid",
        "denied",
        "closed"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ClaimOutcome": {
      "enum": ["paid", "partially_paid", "denied"],
      "title": "ClaimOutcome",
      "type": "string"
    },
    "RiderType": {
      "enum": ["fixed", "indemnity"],
      "title": "RiderType",
      "type": "string"
    },
    "TriState": {
      "enum": ["MATCH", "NO_MATCH", "UNKNOWN"],
      "title": "TriState",
      "type": "string"
    },
    "ClaimCase": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "medical_event_id": {
          "$ref": "#/$defs/Uuid"
        },
        "family_member_id": {
          "$ref": "#/$defs/Uuid"
        },
        "rider_id": {
          "$ref": "#/$defs/Uuid"
        },
        "policy_contract_id": {
          "$ref": "#/$defs/Uuid"
        },
        "insurer_key": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,159}$",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus"
        },
        "receipt_number": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "submitted_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "claimed_amount": {
          "$ref": "#/$defs/DecimalStringOrNull"
        },
        "paid_amount": {
          "$ref": "#/$defs/DecimalStringOrNull"
        },
        "currency": {
          "$ref": "#/$defs/CurrencyCodeOrNull"
        },
        "outcome_reason_code": {
          "$ref": "#/$defs/ReasonCodeOrNull"
        },
        "version": {
          "$ref": "#/$defs/PositiveVersion"
        },
        "deleted": {
          "type": "boolean"
        },
        "allowed_transitions": {
          "items": {
            "$ref": "#/$defs/ClaimStatus"
          },
          "maxItems": 6,
          "uniqueItems": true,
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "id",
        "medical_event_id",
        "family_member_id",
        "rider_id",
        "policy_contract_id",
        "insurer_key",
        "status",
        "receipt_number",
        "submitted_at",
        "claimed_amount",
        "paid_amount",
        "currency",
        "outcome_reason_code",
        "version",
        "deleted",
        "allowed_transitions"
      ],
      "title": "ClaimCase",
      "type": "object"
    },
    "CandidateSnapshotItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "rider_id": {
          "$ref": "#/$defs/Uuid"
        },
        "decision_run_id": {
          "$ref": "#/$defs/UuidOrNull"
        },
        "rider_type": {
          "$ref": "#/$defs/RiderType"
        },
        "rider_label": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "aggregate_result": {
          "$ref": "#/$defs/TriState"
        },
        "version": {
          "$ref": "#/$defs/PositiveVersion"
        },
        "required_match_count": {
          "maximum": 64,
          "minimum": 0,
          "type": "integer"
        },
        "required_unknown_count": {
          "maximum": 64,
          "minimum": 0,
          "type": "integer"
        },
        "required_no_match_count": {
          "maximum": 64,
          "minimum": 0,
          "type": "integer"
        },
        "hold_reason_codes": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "maxItems": 16,
          "type": "array"
        },
        "evaluations": {
          "items": {
            "$ref": "#/$defs/RuleEvaluationSnapshot"
          },
          "maxItems": 256,
          "type": "array"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/QuestionSnapshot"
          },
          "maxItems": 64,
          "type": "array"
        }
      },
      "required": [
        "id",
        "rider_id",
        "rider_type",
        "aggregate_result",
        "required_match_count",
        "required_unknown_count",
        "required_no_match_count",
        "hold_reason_codes"
      ],
      "title": "CandidateSnapshotItem",
      "type": "object"
    },
    "CandidateSnapshot": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "claim-candidate-snapshot-v1",
          "type": "string"
        },
        "run_id": {
          "$ref": "#/$defs/Uuid"
        },
        "medical_event_id": {
          "$ref": "#/$defs/Uuid"
        },
        "event_version": {
          "$ref": "#/$defs/PositiveVersion"
        },
        "engine_version": {
          "$ref": "#/$defs/VersionString"
        },
        "rule_set_version": {
          "$ref": "#/$defs/VersionString"
        },
        "policy_snapshot_at": {
          "$ref": "#/$defs/DateTime"
        },
        "stale": {
          "type": "boolean"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/CandidateSnapshotItem"
          },
          "maxItems": 64,
          "type": "array"
        },
        "evaluations": {
          "items": {
            "$ref": "#/$defs/RuleEvaluationSnapshot"
          },
          "maxItems": 256,
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "medical_event_id",
        "event_version",
        "engine_version",
        "rule_set_version",
        "policy_snapshot_at",
        "stale",
        "candidates",
        "evaluations"
      ],
      "title": "CandidateSnapshot",
      "type": "object"
    },
    "FieldPath": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,63}$",
      "title": "FieldPath",
      "type": "string"
    },
    "QuestionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "$ref": "#/$defs/FieldPath"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        }
      },
      "required": ["field_path", "reason_code"],
      "title": "QuestionSnapshot",
      "type": "object"
    },
    "RuleEvaluationSnapshot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "rider_id": {
          "$ref": "#/$defs/Uuid"
        },
        "rule_version_id": {
          "$ref": "#/$defs/Uuid"
        },
        "result": {
          "$ref": "#/$defs/TriState"
        },
        "required": {
          "type": "boolean"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "fact_paths": {
          "items": {
            "$ref": "#/$defs/FieldPath"
          },
          "maxItems": 16,
          "type": "array"
        },
        "missing_fields": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "conflicting_fields": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "maxItems": 16,
          "type": "array"
        },
        "evaluator_version": {
          "$ref": "#/$defs/VersionString"
        }
      },
      "required": [
        "id",
        "rider_id",
        "rule_version_id",
        "result",
        "required",
        "reason_code",
        "fact_paths",
        "missing_fields",
        "conflicting_fields",
        "evidence_ids",
        "evaluator_version"
      ],
      "title": "RuleEvaluationSnapshot",
      "type": "object"
    },
    "RuleExpression": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "args": {
          "items": {
            "$ref": "#/$defs/RuleExpression"
          },
          "maxItems": 16,
          "type": "array"
        },
        "field": {
          "$ref": "#/$defs/FieldPath"
        },
        "unit": {
          "enum": ["date", "days", "occurrences", "amount", "currency"],
          "type": "string"
        },
        "value": {}
      },
      "required": ["op"],
      "title": "RuleExpression",
      "type": "object"
    },
    "RuleCalculationOperand": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "field": {
              "$ref": "#/$defs/FieldPath"
            }
          },
          "required": ["field"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "value": {}
          },
          "required": ["value"],
          "type": "object"
        },
        {
          "$ref": "#/$defs/RuleCalculation"
        }
      ],
      "title": "RuleCalculationOperand"
    },
    "RuleCalculation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "args": {
          "items": {
            "$ref": "#/$defs/RuleCalculationOperand"
          },
          "maxItems": 16,
          "type": "array"
        },
        "rounding": {
          "$ref": "#/$defs/VersionString"
        }
      },
      "required": ["op", "args"],
      "title": "RuleCalculation",
      "type": "object"
    },
    "RuleDocument": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "coverage-rule-v1",
          "type": "string"
        },
        "rule_kind": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "input_field_paths": {
          "items": {
            "$ref": "#/$defs/FieldPath"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "expression": {
          "$ref": "#/$defs/RuleExpression"
        },
        "calculation": {
          "$ref": "#/$defs/RuleCalculation"
        },
        "result_reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "evidence_ids": {
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "maxItems": 16,
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "rule_kind",
        "required",
        "input_field_paths",
        "result_reason_code",
        "evidence_ids"
      ],
      "title": "RuleDocument",
      "type": "object"
    },
    "RuleVersionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "coverage_rule_id": {
          "$ref": "#/$defs/Uuid"
        },
        "candidate_version_id": {
          "$ref": "#/$defs/Uuid"
        },
        "version_number": {
          "$ref": "#/$defs/PositiveVersion"
        },
        "schema_version": {
          "const": "coverage-rule-v1",
          "type": "string"
        },
        "rule_kind": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "input_field_paths": {
          "items": {
            "$ref": "#/$defs/FieldPath"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "result_reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "review_state": {
          "enum": ["AI_VERIFIED", "NEEDS_REVIEW", "USER_CONFIRMED"],
          "type": "string"
        },
        "executable": {
          "type": "boolean"
        },
        "generator_version": {
          "$ref": "#/$defs/VersionString"
        },
        "verifier_version": {
          "$ref": "#/$defs/VersionString"
        },
        "published_at": {
          "$ref": "#/$defs/DateTime"
        },
        "rule_document": {
          "$ref": "#/$defs/RuleDocument"
        },
        "evidence_ids": {
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "maxItems": 16,
          "type": "array"
        }
      },
      "required": [
        "id",
        "coverage_rule_id",
        "candidate_version_id",
        "version_number",
        "schema_version",
        "rule_kind",
        "required",
        "input_field_paths",
        "result_reason_code",
        "review_state",
        "executable",
        "generator_version",
        "verifier_version",
        "rule_document",
        "evidence_ids"
      ],
      "title": "RuleVersionSnapshot",
      "type": "object"
    },
    "RuleSnapshot": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "claim-rule-snapshot-v1",
          "type": "string"
        },
        "rule_set_version": {
          "$ref": "#/$defs/VersionString"
        },
        "versions": {
          "items": {
            "$ref": "#/$defs/RuleVersionSnapshot"
          },
          "maxItems": 256,
          "type": "array"
        }
      },
      "required": ["schema_version", "versions"],
      "title": "RuleSnapshot",
      "type": "object"
    },
    "PolicySnapshotItem": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/Uuid"
        },
        "rider_id": {
          "$ref": "#/$defs/Uuid"
        },
        "effective_status": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "rider_type": {
          "$ref": "#/$defs/RiderType"
        },
        "rider_label": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "contract_start": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract_end": {
          "$ref": "#/$defs/DateOrNull"
        },
        "rider_coverage_start": {
          "$ref": "#/$defs/DateOrNull"
        },
        "rider_coverage_end": {
          "$ref": "#/$defs/DateOrNull"
        },
        "rider_status": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "insured_amount": {
          "$ref": "#/$defs/DecimalString"
        },
        "currency": {
          "$ref": "#/$defs/CurrencyCode"
        },
        "renewable": {
          "type": "boolean"
        },
        "status_checked_at": {
          "$ref": "#/$defs/DateTime"
        },
        "evidence_ids": {
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "maxItems": 16,
          "type": "array"
        }
      },
      "required": ["policy_id", "rider_id", "effective_status", "evidence_ids"],
      "title": "PolicySnapshotItem",
      "type": "object"
    },
    "PolicySnapshot": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "claim-policy-snapshot-v1",
          "type": "string"
        },
        "snapshots": {
          "items": {
            "$ref": "#/$defs/PolicySnapshotItem"
          },
          "maxItems": 64,
          "type": "array"
        }
      },
      "required": ["schema_version", "snapshots"],
      "title": "PolicySnapshot",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/Uuid"
        },
        "document_version_id": {
          "$ref": "#/$defs/Uuid"
        },
        "extraction_id": {
          "$ref": "#/$defs/Uuid"
        },
        "bbox": {
          "items": {
            "$ref": "#/$defs/DecimalString"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "physical_page": {
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        },
        "review_state": {
          "enum": ["AI_VERIFIED", "NEEDS_REVIEW", "USER_CONFIRMED"],
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "document_version_id",
        "extraction_id",
        "content_sha256",
        "physical_page",
        "review_state"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "EvidenceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "claim-evidence-snapshot-v1",
          "type": "string"
        },
        "evidence": {
