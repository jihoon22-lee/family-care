    "AnalysisAssistanceResponse": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "STRUCTURED_SEARCH",
            "LLM_ASSISTED",
            "NONE"
          ],
          "title": "Mode",
          "type": "string"
        },
        "model_label": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Label"
        },
        "outcome_code": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Outcome Code",
          "type": "string"
        },
        "recommendations": {
          "items": {
            "$ref": "#/$defs/AnalysisRecommendationResponse"
          },
          "maxItems": 12,
          "title": "Recommendations",
          "type": "array"
        },
        "state": {
          "enum": [
            "SEARCH_READY",
            "LLM_PENDING",
            "LLM_READY"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "state",
        "outcome_code",
        "model_label",
        "recommendations"
      ],
      "title": "AnalysisAssistanceResponse",
      "type": "object"
    },
